{
  "index.html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <meta name=\"description\" content=\"拾光城市阅读馆：藏书借阅、安静自习、亲子共读与城市文化讲座，就在街角等你。\" />\n    <title>拾光城市阅读馆 · 让城市慢下来</title>\n  </head>\n  <body>\n    <div id=\"app\"></div>\n    <script type=\"module\" src=\"/src/main.js\"></script>\n  </body>\n</html>\n",
  "package.json": "{\"name\":\"generated-vue-app\",\"version\":\"1.0.0\",\"private\":true,\"type\":\"module\",\n\"engines\":{\"node\":\">=18\"},\"scripts\":{\"dev\":\"vite\",\"build\":\"vite build\"},\n\"dependencies\":{\"vue\":\"3.3.4\",\"vue-router\":\"4.2.4\"},\n\"devDependencies\":{\"@vitejs/plugin-vue\":\"4.2.3\",\"vite\":\"4.4.5\"}}\n",
  "src/App.vue": "<script setup>\nimport { ref, watch } from 'vue'\nimport { useRoute } from 'vue-router'\n\nconst route = useRoute()\nconst menuOpen = ref(false)\n\nconst navs = [\n  { to: '/', label: '首页' },\n  { to: '/books', label: '馆藏书目' },\n  { to: '/guide', label: '到馆指南' }\n]\n\nwatch(\n  () => route.fullPath,\n  () => {\n    menuOpen.value = false\n    document.title = route.meta.title\n      ? `${route.meta.title} · 拾光城市阅读馆`\n      : '拾光城市阅读馆 · 让城市慢下来'\n  },\n  { immediate: true }\n)\n</script>\n\n<template>\n  <div class=\"app\">\n    <header class=\"site-header\">\n      <div class=\"wrap bar\">\n        <router-link to=\"/\" class=\"logo\">\n          <span class=\"mark\">拾光</span>\n          <span class=\"name\">\n            城市阅读馆\n            <small>SHIGUANG CITY READING HALL</small>\n          </span>\n        </router-link>\n\n        <nav class=\"nav\" :class=\"{ open: menuOpen }\">\n          <router-link v-for=\"item in navs\" :key=\"item.to\" :to=\"item.to\" class=\"nav-link\">\n            {{ item.label }}\n          </router-link>\n          <span class=\"open-tip\">每日 09:00 - 21:00 开放</span>\n        </nav>\n\n        <button class=\"toggle\" type=\"button\" aria-label=\"切换菜单\" @click=\"menuOpen = !menuOpen\">\n          <span :class=\"{ x: menuOpen }\"></span>\n        </button>\n      </div>\n    </header>\n\n    <main>\n      <router-view />\n    </main>\n\n    <footer class=\"site-footer\">\n      <div class=\"wrap foot-grid\">\n        <div>\n          <h4>拾光城市阅读馆</h4>\n          <p>一间开在街角的公共阅读空间，藏书四万余册，全年免费开放。</p>\n        </div>\n        <div>\n          <h4>开放时间</h4>\n          <p>周一至周五 09:00 - 21:00</p>\n          <p>周六至周日 09:00 - 21:30</p>\n        </div>\n        <div>\n          <h4>联系地址</h4>\n          <p>云栖市文华路 88 号 · 城市书房街区</p>\n          <p>电话 021-6688 5520</p>\n        </div>\n        <div>\n          <h4>快速导航</h4>\n          <router-link v-for=\"item in navs\" :key=\"item.to\" :to=\"item.to\" class=\"foot-link\">\n            {{ item.label }}\n          </router-link>\n        </div>\n      </div>\n      <div class=\"wrap copy\">© 2024 拾光城市阅读馆 · 让每一次翻页都有回声</div>\n    </footer>\n  </div>\n</template>\n\n<style scoped>\n.app {\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n}\n\nmain {\n  flex: 1;\n}\n\n.site-header {\n  position: sticky;\n  top: 0;\n  z-index: 30;\n  background: rgba(248, 245, 238, 0.94);\n  backdrop-filter: blur(10px);\n  border-bottom: 1px solid var(--line);\n}\n\n.bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n  height: 74px;\n}\n\n.logo {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.mark {\n  display: grid;\n  place-items: center;\n  width: 44px;\n  height: 44px;\n  border-radius: 12px;\n  background: var(--brand);\n  color: #fff;\n  font-size: 15px;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n}\n\n.name {\n  display: flex;\n  flex-direction: column;\n  font-size: 18px;\n  font-weight: 700;\n  line-height: 1.2;\n}\n\n.name small {\n  font-size: 10px;\n  font-weight: 400;\n  letter-spacing: 0.14em;\n  color: var(--ink-soft);\n}\n\n.nav {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.nav-link {\n  padding: 8px 16px;\n  border-radius: 999px;\n  font-size: 15px;\n  color: var(--ink-soft);\n  transition: background 0.18s ease, color 0.18s ease;\n}\n\n.nav-link:hover {\n  color: var(--ink);\n  background: #fff;\n}\n\n.nav-link.router-link-exact-active {\n  background: var(--brand);\n  color: #fff;\n  font-weight: 600;\n}\n\n.open-tip {\n  margin-left: 12px;\n  font-size: 13px;\n  color: var(--ink-soft);\n}\n\n.toggle {\n  display: none;\n  width: 42px;\n  height: 42px;\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  background: #fff;\n  position: relative;\n}\n\n.toggle span,\n.toggle span::before,\n.toggle span::after {\n  position: absolute;\n  left: 50%;\n  width: 18px;\n  height: 2px;\n  border-radius: 2px;\n  background: var(--ink);\n  transform: translateX(-50%);\n  transition: transform 0.2s ease, opacity 0.2s ease;\n  content: '';\n}\n\n.toggle span {\n  top: 20px;\n}\n\n.toggle span::before {\n  top: -6px;\n}\n\n.toggle span::after {\n  top: 6px;\n}\n\n.toggle span.x {\n  background: transparent;\n}\n\n.toggle span.x::before {\n  top: 0;\n  transform: translateX(-50%) rotate(45deg);\n}\n\n.toggle span.x::after {\n  top: 0;\n  transform: translateX(-50%) rotate(-45deg);\n}\n\n.site-footer {\n  margin-top: 40px;\n  padding: 44px 0 24px;\n  background: #23282c;\n  color: #d7d3ca;\n}\n\n.foot-grid {\n  display: grid;\n  grid-template-columns: 1.4fr 1fr 1.2fr 0.8fr;\n  gap: 28px;\n}\n\n.site-footer h4 {\n  margin-bottom: 12px;\n  font-size: 15px;\n  color: #fff;\n}\n\n.site-footer p {\n  font-size: 14px;\n  line-height: 1.8;\n  color: #a9a49a;\n}\n\n.foot-link {\n  display: block;\n  font-size: 14px;\n  color: #a9a49a;\n  padding: 2px 0;\n}\n\n.foot-link:hover {\n  color: #fff;\n}\n\n.copy {\n  margin-top: 32px;\n  padding-top: 18px;\n  border-top: 1px solid rgba(255, 255, 255, 0.1);\n  font-size: 13px;\n  color: #8d887f;\n}\n\n@media (max-width: 900px) {\n  .open-tip {\n    display: none;\n  }\n  .foot-grid {\n    grid-template-columns: 1fr 1fr;\n  }\n}\n\n@media (max-width: 720px) {\n  .toggle {\n    display: block;\n  }\n  .nav {\n    position: absolute;\n    top: 74px;\n    left: 0;\n    right: 0;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 4px;\n    padding: 12px 16px 18px;\n    background: #fff;\n    border-bottom: 1px solid var(--line);\n    box-shadow: var(--shadow);\n    display: none;\n  }\n  .nav.open {\n    display: flex;\n  }\n  .nav-link {\n    padding: 12px 14px;\n    border-radius: 10px;\n  }\n  .name {\n    font-size: 16px;\n  }\n  .name small {\n    display: none;\n  }\n  .foot-grid {\n    grid-template-columns: 1fr;\n    gap: 22px;\n  }\n}\n</style>\n",
  "src/components/BookCard.vue": "<script setup>\ndefineProps({\n  book: {\n    type: Object,\n    required: true\n  }\n})\n</script>\n\n<template>\n  <article class=\"book-card\">\n    <div class=\"cover\">\n      <img :src=\"book.cover\" :alt=\"book.title + ' 封面'\" loading=\"lazy\" />\n      <span class=\"status\" :class=\"book.status === '在馆' ? 'on' : 'off'\">{{ book.status }}</span>\n    </div>\n    <div class=\"info\">\n      <span class=\"cat\">{{ book.category }}</span>\n      <h3>{{ book.title }}</h3>\n      <p class=\"author\">{{ book.author }} · {{ book.press }} · {{ book.year }}</p>\n      <p class=\"summary\">{{ book.summary }}</p>\n      <div class=\"meta\">\n        <span>架位 {{ book.shelf }}</span>\n      </div>\n    </div>\n  </article>\n</template>\n\n<style scoped>\n.book-card {\n  display: flex;\n  flex-direction: column;\n  background: var(--card);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  overflow: hidden;\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n\n.book-card:hover {\n  transform: translateY(-4px);\n  box-shadow: var(--shadow);\n}\n\n.cover {\n  position: relative;\n  aspect-ratio: 4 / 5;\n  background: var(--brand-soft);\n}\n\n.cover img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.status {\n  position: absolute;\n  top: 10px;\n  right: 10px;\n  padding: 3px 10px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 600;\n  color: #fff;\n}\n\n.status.on {\n  background: var(--accent);\n}\n\n.status.off {\n  background: #a8742f;\n}\n\n.info {\n  padding: 16px 18px 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  flex: 1;\n}\n\n.cat {\n  align-self: flex-start;\n  padding: 2px 10px;\n  border-radius: 999px;\n  background: var(--brand-soft);\n  color: var(--brand-dark);\n  font-size: 12px;\n}\n\n.info h3 {\n  font-size: 18px;\n}\n\n.author {\n  font-size: 13px;\n  color: var(--ink-soft);\n}\n\n.summary {\n  font-size: 14px;\n  color: var(--ink-soft);\n  line-height: 1.65;\n}\n\n.meta {\n  margin-top: auto;\n  padding-top: 10px;\n  border-top: 1px dashed var(--line);\n  font-size: 13px;\n  color: var(--brand-dark);\n}\n</style>\n",
  "src/data/books.js": "export const categories = ['全部', '文学', '历史', '社科', '科幻', '童书', '艺术', '心理', '传记']\n\nexport const books = [\n  {\n    id: 1,\n    title: '活着',\n    author: '余华',\n    category: '文学',\n    press: '作家出版社',\n    year: 2012,\n    cover: 'https://picsum.photos/seed/reading-hall-1/360/480',\n    summary: '一个普通人在时代洪流里守住生活的重量，读来平静而有力量。',\n    shelf: 'A-03-12',\n    status: '在馆'\n  },\n  {\n    id: 2,\n    title: '百年孤独',\n    author: '加西亚·马尔克斯',\n    category: '文学',\n    press: '南海出版公司',\n    year: 2011,\n    cover: 'https://picsum.photos/seed/reading-hall-2/360/480',\n    summary: '马孔多小镇七代人的兴衰，魔幻与现实交织的家族史诗。',\n    shelf: 'A-05-04',\n    status: '借出'\n  },\n  {\n    id: 3,\n    title: '人类简史',\n    author: '尤瓦尔·赫拉利',\n    category: '社科',\n    press: '中信出版社',\n    year: 2014,\n    cover: 'https://picsum.photos/seed/reading-hall-3/360/480',\n    summary: '从认知革命讲到科技革命，重新理解人类如何成为世界的主人。',\n    shelf: 'C-01-08',\n    status: '在馆'\n  },\n  {\n    id: 4,\n    title: '万历十五年',\n    author: '黄仁宇',\n    category: '历史',\n    press: '中华书局',\n    year: 2006,\n    cover: 'https://picsum.photos/seed/reading-hall-4/360/480',\n    summary: '以 1587 年为切口，看见一个王朝的制度困境与人物命运。',\n    shelf: 'B-02-17',\n    status: '在馆'\n  },\n  {\n    id: 5,\n    title: '置身事内',\n    author: '兰小欢',\n    category: '社科',\n    press: '上海人民出版社',\n    year: 2021,\n    cover: 'https://picsum.photos/seed/reading-hall-5/360/480',\n    summary: '用地方政府与经济的关系，讲清中国城市发展的来路与去向。',\n    shelf: 'C-03-06',\n    status: '在馆'\n  },\n  {\n    id: 6,\n    title: '小王子',\n    author: '圣埃克苏佩里',\n    category: '童书',\n    press: '人民文学出版社',\n    year: 2018,\n    cover: 'https://picsum.photos/seed/reading-hall-6/360/480',\n    summary: '写给大人们的童话，关于陪伴、责任与看不见的真心。',\n    shelf: 'D-01-02',\n    status: '在馆'\n  },\n  {\n    id: 7,\n    title: '窗边的小豆豆',\n    author: '黑柳彻子',\n    category: '童书',\n    press: '南海出版公司',\n    year: 2011,\n    cover: 'https://picsum.photos/seed/reading-hall-7/360/480',\n    summary: '巴学园里被认真倾听的童年，适合与孩子一起共读。',\n    shelf: 'D-02-11',\n    status: '借出'\n  },\n  {\n    id: 8,\n    title: '球状闪电',\n    author: '刘慈欣',\n    category: '科幻',\n    press: '四川科学技术出版社',\n    year: 2005,\n    cover: 'https://picsum.photos/seed/reading-hall-8/360/480',\n    summary: '一场关于宏原子与执念的追逐，通向看不见的物理世界。',\n    shelf: 'E-04-09',\n    status: '在馆'\n  },\n  {\n    id: 9,\n    title: '设计中的设计',\n    author: '原研哉',\n    category: '艺术',\n    press: '广西师范大学出版社',\n    year: 2010,\n    cover: 'https://picsum.photos/seed/reading-hall-9/360/480',\n    summary: '从白纸与空无讲起，理解日常物件背后的设计思考。',\n    shelf: 'F-01-05',\n    status: '在馆'\n  },\n  {\n    id: 10,\n    title: '苏东坡传',\n    author: '林语堂',\n    category: '传记',\n    press: '湖南文艺出版社',\n    year: 2018,\n    cover: 'https://picsum.photos/seed/reading-hall-10/360/480',\n    summary: '一位诗人如何在颠簸人生中保持热烈与旷达。',\n    shelf: 'G-02-14',\n    status: '在馆'\n  },\n  {\n    id: 11,\n    title: '也许你该找个人聊聊',\n    author: '洛莉·戈特利布',\n    category: '心理',\n    press: '上海文化出版社',\n    year: 2021,\n    cover: 'https://picsum.photos/seed/reading-hall-11/360/480',\n    summary: '心理咨询室里的五个故事，也是每个人都会遇到的困境。',\n    shelf: 'H-03-07',\n    status: '借出'\n  },\n  {\n    id: 12,\n    title: '平凡的世界',\n    author: '路遥',\n    category: '文学',\n    press: '北京十月文艺出版社',\n    year: 2017,\n    cover: 'https://picsum.photos/seed/reading-hall-12/360/480',\n    summary: '黄土高原上年轻人的奋斗与爱情，一代人的共同记忆。',\n    shelf: 'A-07-01',\n    status: '在馆'\n  },\n  {\n    id: 13,\n    title: '中国大历史',\n    author: '黄仁宇',\n    category: '历史',\n    press: '生活·读书·新知三联书店',\n    year: 2007,\n    cover: 'https://picsum.photos/seed/reading-hall-13/360/480',\n    summary: '用大视野俯瞰数千年，梳理中国社会的结构与节奏。',\n    shelf: 'B-04-10',\n    status: '在馆'\n  },\n  {\n    id: 14,\n    title: '数学之美',\n    author: '吴军',\n    category: '社科',\n    press: '人民邮电出版社',\n    year: 2014,\n    cover: 'https://picsum.photos/seed/reading-hall-14/360/480',\n    summary: '从搜索到语音识别，看懂生活背后的简单数学原理。',\n    shelf: 'C-06-03',\n    status: '在馆'\n  },\n  {\n    id: 15,\n    title: '草房子',\n    author: '曹文轩',\n    category: '童书',\n    press: '江苏少年儿童出版社',\n    year: 2016,\n    cover: 'https://picsum.photos/seed/reading-hall-15/360/480',\n    summary: '油麻地小学的少年往事，温柔讲述成长与告别。',\n    shelf: 'D-03-18',\n    status: '在馆'\n  }\n]\n\nexport const events = [\n  {\n    id: 1,\n    date: '5 月 18 日',\n    time: '周六 14:00 - 16:00',\n    title: '城市读书会：《置身事内》共读',\n    place: '二层 · 讲堂',\n    desc: '与经济学编辑一起，从身边街道的变化读起，聊聊城市与人的关系。'\n  },\n  {\n    id: 2,\n    date: '5 月 25 日',\n    time: '周六 10:00 - 11:30',\n    title: '亲子绘本剧场：小种子的旅行',\n    place: '一层 · 童书角',\n    desc: '绘本讲述 + 手工拼贴，4 至 8 岁小朋友与家长共同参与。'\n  },\n  {\n    id: 3,\n    date: '6 月 8 日',\n    time: '周六 19:00 - 20:30',\n    title: '夜间书房：一场关于旧城的摄影分享',\n    place: '三层 · 天光厅',\n    desc: '摄影师带来十年街巷影像，讲述一座城市如何慢慢生长。'\n  }\n]\n\nexport const notices = [\n  '5 月 20 日起，三层自习区延长开放至 21:30，凭读者证入座。',\n  '馆内新到 2023 年新书 260 册，位于一层新书推荐架。',\n  '每月最后一个周一为设备维护日，上午闭馆，下午 13:00 开馆。'\n]\n",
  "src/main.js": "import { createApp } from 'vue'\nimport App from './App.vue'\nimport router from './router'\nimport './styles/global.css'\n\ncreateApp(App).use(router).mount('#app')\n",
  "src/pages/BooksView.vue": "<script setup>\nimport { computed, ref } from 'vue'\nimport BookCard from '@/components/BookCard.vue'\nimport { books, categories } from '@/data/books.js'\n\nconst keyword = ref('')\nconst activeCat = ref('全部')\nconst onlyAvailable = ref(false)\n\nconst filtered = computed(() => {\n  const key = keyword.value.trim().toLowerCase()\n  return books.filter((book) => {\n    const matchCat = activeCat.value === '全部' || book.category === activeCat.value\n    const matchKey =\n      !key ||\n      book.title.toLowerCase().includes(key) ||\n      book.author.toLowerCase().includes(key) ||\n      book.press.toLowerCase().includes(key) ||\n      book.summary.toLowerCase().includes(key)\n    const matchStatus = !onlyAvailable.value || book.status === '在馆'\n    return matchCat && matchKey && matchStatus\n  })\n})\n\nfunction reset() {\n  keyword.value = ''\n  activeCat.value = '全部'\n  onlyAvailable.value = false\n}\n</script>\n\n<template>\n  <div class=\"books-page\">\n    <div class=\"wrap\">\n      <header class=\"page-head\">\n        <span class=\"eyebrow\">馆藏书目</span>\n        <h1>四万余册书，总有一本等着你</h1>\n        <p>按书名、作者或出版社检索，也可以直接挑选感兴趣的分类。标注“在馆”的图书可到一层借阅台直接取阅。</p>\n      </header>\n\n      <div class=\"panel\">\n        <div class=\"search\">\n          <input\n            v-model=\"keyword\"\n            type=\"search\"\n            placeholder=\"搜索书名、作者或出版社，例如：余华\"\n            aria-label=\"搜索书目\"\n          />\n          <button v-if=\"keyword\" class=\"clear\" type=\"button\" @click=\"keyword = ''\">清除</button>\n        </div>\n        <div class=\"cats\">\n          <button\n            v-for=\"cat in categories\"\n            :key=\"cat\"\n            type=\"button\"\n            class=\"chip\"\n            :class=\"{ active: activeCat === cat }\"\n            @click=\"activeCat = cat\"\n          >\n            {{ cat }}\n          </button>\n        </div>\n        <div class=\"panel-foot\">\n          <label class=\"switch\">\n            <input v-model=\"onlyAvailable\" type=\"checkbox\" />\n            <span>只看在馆图书</span>\n          </label>\n          <span class=\"count\">共 {{ filtered.length }} 条结果</span>\n        </div>\n      </div>\n\n      <div v-if=\"filtered.length\" class=\"grid book-grid\">\n        <BookCard v-for=\"book in filtered\" :key=\"book.id\" :book=\"book\" />\n      </div>\n\n      <div v-else class=\"empty\">\n        <strong>暂时没有找到相关图书</strong>\n        <p>试试更换关键词，或者让馆员帮你从储备书库调取。</p>\n        <button class=\"btn btn-primary\" type=\"button\" @click=\"reset\">重置筛选条件</button>\n      </div>\n\n      <div class=\"tips\">\n        <div>\n          <h3>借阅规则</h3>\n          <p>免费办证 · 一次 6 册 · 借期 30 天 · 可续借 1 次</p>\n        </div>\n        <div>\n          <h3>新书速递</h3>\n          <p>每月 1 日上新约 60 册，位于一层入口处新书推荐架。</p>\n        </div>\n        <div>\n          <h3>预约取书</h3>\n          <p>在服务台或电话登记书名，保留 48 小时，逾期自动回架。</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.books-page {\n  padding: 44px 0 30px;\n}\n\n.page-head {\n  max-width: 700px;\n  margin-bottom: 26px;\n}\n\n.page-head h1 {\n  font-size: 34px;\n  line-height: 1.3;\n}\n\n.page-head p {\n  margin-top: 12px;\n  color: var(--ink-soft);\n}\n\n.panel {\n  padding: 20px 22px;\n  margin-bottom: 30px;\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: 18px;\n}\n\n.search {\n  position: relative;\n}\n\n.search input {\n  width: 100%;\n  padding: 13px 74px 13px 16px;\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  background: var(--paper);\n  font-family: inherit;\n  font-size: 15px;\n  color: var(--ink);\n  outline: none;\n  transition: border-color 0.18s ease, background 0.18s ease;\n}\n\n.search input:focus {\n  border-color: var(--brand);\n  background: #fff;\n}\n\n.clear {\n  position: absolute;\n  top: 50%;\n  right: 10px;\n  transform: translateY(-50%);\n  padding: 5px 12px;\n  border: none;\n  border-radius: 8px;\n  background: var(--brand-soft);\n  color: var(--brand-dark);\n  font-size: 13px;\n}\n\n.cats {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 16px;\n}\n\n.chip {\n  padding: 7px 16px;\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  background: #fff;\n  font-size: 14px;\n  color: var(--ink-soft);\n  transition: all 0.18s ease;\n}\n\n.chip:hover {\n  border-color: var(--brand);\n  color: var(--brand-dark);\n}\n\n.chip.active {\n  background: var(--brand);\n  border-color: var(--brand);\n  color: #fff;\n  font-weight: 600;\n}\n\n.panel-foot {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-top: 16px;\n  padding-top: 14px;\n  border-top: 1px dashed var(--line);\n  font-size: 14px;\n  color: var(--ink-soft);\n}\n\n.switch {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  cursor: pointer;\n}\n\n.switch input {\n  width: 16px;\n  height: 16px;\n  accent-color: var(--brand);\n}\n\n.count {\n  color: var(--brand-dark);\n  font-weight: 600;\n}\n\n.book-grid {\n  grid-template-columns: repeat(4, 1fr);\n}\n\n.empty {\n  padding: 60px 24px;\n  text-align: center;\n  background: #fff;\n  border: 1px dashed var(--line);\n  border-radius: 18px;\n}\n\n.empty strong {\n  display: block;\n  font-size: 18px;\n}\n\n.empty p {\n  margin: 8px 0 20px;\n  color: var(--ink-soft);\n  font-size: 14px;\n}\n\n.tips {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 18px;\n  margin-top: 34px;\n}\n\n.tips > div {\n  padding: 20px 22px;\n  background: #f2eee4;\n  border-radius: 14px;\n}\n\n.tips h3 {\n  font-size: 16px;\n  margin-bottom: 6px;\n}\n\n.tips p {\n  font-size: 14px;\n  color: var(--ink-soft);\n}\n\n@media (max-width: 1000px) {\n  .book-grid {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n@media (max-width: 820px) {\n  .page-head h1 {\n    font-size: 26px;\n  }\n  .book-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .tips {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 560px) {\n  .books-page {\n    padding: 28px 0 20px;\n  }\n  .page-head h1 {\n    font-size: 21px;\n  }\n  .panel {\n    padding: 16px 14px;\n  }\n  .book-grid {\n    grid-template-columns: 1fr;\n  }\n}\n</style>\n",
  "src/pages/GuideView.vue": "<script setup>\nimport { computed, reactive, ref } from 'vue'\n\nconst hours = [\n  { day: '周一', time: '09:00 - 21:00', note: '设备维护日上午闭馆' },\n  { day: '周二', time: '09:00 - 21:00', note: '正常开放' },\n  { day: '周三', time: '09:00 - 21:00', note: '城市讲堂 19:00' },\n  { day: '周四', time: '09:00 - 21:00', note: '正常开放' },\n  { day: '周五', time: '09:00 - 21:00', note: '夜间书房至 21:30' },\n  { day: '周六', time: '09:00 - 21:30', note: '亲子故事会 10:00' },\n  { day: '周日', time: '09:00 - 21:30', note: '旧书漂流整理日' }\n]\n\nconst traffic = [\n  {\n    icon: '🚇',\n    title: '地铁',\n    desc: '3 号线「文华路」站 B 口出，沿文华路向东南步行约 300 米，看到红砖厂房即是。'\n  },\n  {\n    icon: '🚌',\n    title: '公交',\n    desc: '乘坐 12 路、46 路、108 路至「城市书房」站下车，过斑马线后步行 2 分钟。'\n  },\n  {\n    icon: '🚲',\n    title: '骑行 / 自驾',\n    desc: '馆前设有 80 个共享单车停放位；地下车库工作日 18:00 后对读者开放，周末全天开放。'\n  }\n]\n\nconst rules = [\n  '凭身份证或读者证入馆，无需提前预约；团体 10 人以上请提前两天致电登记。',\n  '馆内请保持安静，手机调至静音，接听电话请移步一层门厅。',\n  '书刊外借请到借阅台办理，未借阅图书请放回还书车，不必自行归架。',\n  '二层设有饮水间与简餐区，馆内其他区域请勿进食。',\n  '童书角需家长全程陪同，请勿让小朋友在书架间奔跑。',\n  '拍摄分享时请避开他人正脸，尊重每位读者的阅读时光。'\n]\n\nconst floors = [\n  { level: '三层', name: '静读与天光厅', desc: '232 个自习座位、期刊区、城市影像档案' },\n  { level: '二层', name: '人文社科与讲堂', desc: '社科与历史书库、视听试听台、80 人讲堂' },\n  { level: '一层', name: '借阅大厅与童书角', desc: '新书推荐架、借阅台、亲子共读区、漂流书架' },\n  { level: '夹层', name: '办公与储藏', desc: '储备书库、活动物料间（读者请止步）' }\n]\n\nconst faqs = [\n  {\n    q: '第一次来需要带什么？',\n    a: '带上身份证即可。在借阅台填写一张登记卡，当场办好读者证，全程免费，无需押金。'\n  },\n  {\n    q: '可以带自己的书来读吗？',\n    a: '可以。自带书籍不用登记，离馆时带走即可；若想在馆内自习，可在一层服务台取用书立与阅读架。'\n  },\n  {\n    q: '座位需要预约吗？',\n    a: '三层静读区座位支持线上预约，当日 08:30 开放次日的预约；一层与二层区域为自由选座。离座超过 30 分钟视为让位。'\n  },\n  {\n    q: '图书可以续借吗？',\n    a: '可以续借 1 次，借期延长 15 天。到馆、电话或读者证绑定的小程序都能办理。'\n  },\n  {\n    q: '馆内有 Wi-Fi 吗？',\n    a: '有。连接「Shiguang-Reader」，读者证号后六位即为当日密码，单次可在线 4 小时。'\n  }\n]\n\nconst form = reactive({ name: '', phone: '', date: '', people: '1 人', seat: '三层静读区' })\nconst submitted = ref(false)\nconst formError = ref('')\n\nconst canSubmit = computed(() => form.name.trim() && form.phone.trim() && form.date)\n\nfunction submit() {\n  if (!canSubmit.value) {\n    formError.value = '请填写姓名、联系电话与到馆日期'\n    return\n  }\n  formError.value = ''\n  submitted.value = true\n}\n\nfunction again() {\n  submitted.value = false\n  form.name = ''\n  form.phone = ''\n  form.date = ''\n}\n</script>\n\n<template>\n  <div class=\"guide\">\n    <section class=\"wrap page-head\">\n      <span class=\"eyebrow\">到馆指南</span>\n      <h1>第一次来？从这页开始就好</h1>\n      <p>地址、交通、开放时间、入馆须知与常见问题，都在这里。填写下方表单，即可预留一个属于你的座位。</p>\n    </section>\n\n    <section class=\"wrap info-grid\">\n      <div class=\"card address\">\n        <h2>馆舍位置</h2>\n        <p class=\"addr\">云栖市文华路 88 号 · 城市书房街区（红砖厂房 1 号楼）</p>\n        <ul class=\"contact\">\n          <li><span>咨询电话</span><em>021-6688 5520</em></li>\n          <li><span>服务邮箱</span><em>hello@shiguang-read.org</em></li>\n          <li><span>读者交流群</span><em>关注“拾光阅读”公众号入群</em></li>\n        </ul>\n        <img :src=\"'https://picsum.photos/seed/reading-hall-map/800/460'\" alt=\"阅读馆周边街景\" />\n      </div>\n\n      <div class=\"card hours\">\n        <h2>开放时间</h2>\n        <ul class=\"hours-list\">\n          <li v-for=\"h in hours\" :key=\"h.day\">\n            <span class=\"day\">{{ h.day }}</span>\n            <span class=\"time\">{{ h.time }}</span>\n            <span class=\"note\">{{ h.note }}</span>\n          </li>\n        </ul>\n        <p class=\"hours-tip\">法定节假日开放时间另行公告，闭馆前 30 分钟停止入馆。</p>\n      </div>\n    </section>\n\n    <section class=\"wrap section-block\">\n      <div class=\"block-head\">\n        <h2>怎么到达</h2>\n        <p>三条路线任选，步行都在五分钟以内。</p>\n      </div>\n      <div class=\"traffic-grid\">\n        <div v-for=\"t in traffic\" :key=\"t.title\" class=\"card traffic\">\n          <span class=\"icon\">{{ t.icon }}</span>\n          <h3>{{ t.title }}</h3>\n          <p>{{ t.desc }}</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"wrap section-block two-col\">\n      <div class=\"card\">\n        <h2>入馆须知</h2>\n        <ol class=\"rules\">\n          <li v-for=\"(r, i) in rules\" :key=\"i\">{{ r }}</li>\n        </ol>\n      </div>\n      <div class=\"card\">\n        <h2>楼层指引</h2>\n        <ul class=\"floors\">\n          <li v-for=\"f in floors\" :key=\"f.level\">\n            <span class=\"level\">{{ f.level }}</span>\n            <div>\n              <strong>{{ f.name }}</strong>\n              <p>{{ f.desc }}</p>\n            </div>\n          </li>\n        </ul>\n      </div>\n    </section>\n\n    <section class=\"wrap section-block booking\">\n      <div class=\"booking-text\">\n        <h2>预约到馆座位</h2>\n        <p>席位保留至预约时段结束后 1 小时，如需取消请提前一天电话告知，把位置留给其他读者。</p>\n        <div class=\"booking-facts\">\n          <div><strong>08:30</strong><span>每日开放次日预约</span></div>\n          <div><strong>30 分钟</strong><span>离座视为让位</span></div>\n          <div><strong>4 小时</strong><span>免费 Wi-Fi 单次时长</span></div>\n        </div>\n      </div>\n\n      <div class=\"card booking-form\">\n        <template v-if=\"!submitted\">\n          <label>\n            <span>姓名</span>\n            <input v-model=\"form.name\" type=\"text\" placeholder=\"请填写真实姓名\" />\n          </label>\n          <label>\n            <span>联系电话</span>\n            <input v-model=\"form.phone\" type=\"tel\" placeholder=\"方便到馆提醒\" />\n          </label>\n          <div class=\"form-row\">\n            <label>\n              <span>到馆日期</span>\n              <input v-model=\"form.date\" type=\"date\" />\n            </label>\n            <label>\n              <span>同行人数</span>\n              <select v-model=\"form.people\">\n                <option>1 人</option>\n                <option>2 人</option>\n                <option>3-5 人</option>\n                <option>5 人以上</option>\n              </select>\n            </label>\n          </div>\n          <label>\n            <span>意向区域</span>\n            <select v-model=\"form.seat\">\n              <option>一层借阅大厅</option>\n              <option>二层人文社科区</option>\n              <option>三层静读区</option>\n              <option>一层童书角（亲子）</option>\n            </select>\n          </label>\n          <p v-if=\"formError\" class=\"error\">{{ formError }}</p>\n          <button class=\"btn btn-primary submit\" type=\"button\" @click=\"submit\">提交预约</button>\n        </template>\n        <div v-else class=\"success\">\n          <strong>预约已提交</strong>\n          <p>{{ form.name }}，{{ form.date }} 为你在「{{ form.seat }}」留好位置，馆员会通过电话与你确认。</p>\n          <button class=\"btn btn-ghost\" type=\"button\" @click=\"again\">再预约一次</button>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"wrap section-block faq\">\n      <div class=\"block-head\">\n        <h2>常见问题</h2>\n        <p>还没找到答案？在服务台随时问我们。</p>\n      </div>\n      <details v-for=\"(f, i) in faqs\" :key=\"i\" class=\"faq-item\" :open=\"i === 0\">\n        <summary>{{ f.q }}</summary>\n        <p>{{ f.a }}</p>\n      </details>\n    </section>\n  </div>\n</template>\n\n<style scoped>\n.guide {\n  padding: 44px 0 20px;\n}\n\n.page-head {\n  max-width: 720px;\n  margin-bottom: 28px;\n}\n\n.page-head h1 {\n  font-size: 34px;\n  line-height: 1.3;\n}\n\n.page-head p {\n  margin-top: 12px;\n  color: var(--ink-soft);\n}\n\n.card {\n  padding: 24px;\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n}\n\n.card h2 {\n  font-size: 19px;\n  margin-bottom: 14px;\n}\n\n.info-grid {\n  display: grid;\n  grid-template-columns: 1.1fr 1fr;\n  gap: 22px;\n}\n\n.addr {\n  font-size: 15px;\n  color: var(--ink-soft);\n}\n\n.contact {\n  list-style: none;\n  margin: 16px 0;\n  padding: 0;\n}\n\n.contact li {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 8px 0;\n  border-bottom: 1px dashed var(--line);\n  font-size: 14px;\n  color: var(--ink-soft);\n}\n\n.contact em {\n  font-style: normal;\n  color: var(--ink);\n  font-weight: 600;\n}\n\n.address img {\n  width: 100%;\n  aspect-ratio: 16 / 9;\n  object-fit: cover;\n  border-radius: 12px;\n  margin-top: 4px;\n}\n\n.hours-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.hours-list li {\n  display: grid;\n  grid-template-columns: 52px 1fr auto;\n  align-items: center;\n  gap: 10px;\n  padding: 9px 0;\n  border-bottom: 1px dashed var(--line);\n  font-size: 14px;\n}\n\n.hours-list .day {\n  font-weight: 700;\n  color: var(--brand-dark);\n}\n\n.hours-list .time {\n  color: var(--ink);\n}\n\n.hours-list .note {\n  font-size: 12px;\n  color: var(--ink-soft);\n  text-align: right;\n}\n\n.hours-tip {\n  margin-top: 14px;\n  font-size: 13px;\n  color: var(--ink-soft);\n}\n\n.section-block {\n  margin-top: 34px;\n}\n\n.block-head {\n  margin-bottom: 18px;\n}\n\n.block-head h2 {\n  font-size: 24px;\n}\n\n.block-head p {\n  margin-top: 6px;\n  color: var(--ink-soft);\n  font-size: 14px;\n}\n\n.traffic-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 18px;\n}\n\n.traffic .icon {\n  display: grid;\n  place-items: center;\n  width: 42px;\n  height: 42px;\n  margin-bottom: 12px;\n  border-radius: 12px;\n  background: var(--brand-soft);\n  font-size: 20px;\n}\n\n.traffic h3 {\n  font-size: 16px;\n  margin-bottom: 6px;\n}\n\n.traffic p {\n  font-size: 14px;\n  color: var(--ink-soft);\n}\n\n.two-col {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 22px;\n  align-items: start;\n}\n\n.rules {\n  margin: 0;\n  padding-left: 20px;\n  color: var(--ink-soft);\n  font-size: 14px;\n}\n\n.rules li {\n  padding: 6px 0;\n}\n\n.floors {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.floors li {\n  display: flex;\n  gap: 14px;\n  padding: 10px 0;\n  border-bottom: 1px dashed var(--line);\n}\n\n.floors li:last-child {\n  border-bottom: none;\n}\n\n.level {\n  flex: none;\n  padding: 2px 10px;\n  height: 26px;\n  border-radius: 8px;\n  background: var(--brand-soft);\n  color: var(--brand-dark);\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.floors strong {\n  font-size: 15px;\n}\n\n.floors p {\n  font-size: 13px;\n  color: var(--ink-soft);\n}\n\n.booking {\n  display: grid;\n  grid-template-columns: 1fr 1.1fr;\n  gap: 28px;\n  align-items: center;\n  padding: 32px 28px;\n  background: #f2eee4;\n  border-radius: 22px;\n}\n\n.booking-text h2 {\n  font-size: 24px;\n}\n\n.booking-text p {\n  margin-top: 10px;\n  color: var(--ink-soft);\n  font-size: 14px;\n}\n\n.booking-facts {\n  display: flex;\n  gap: 22px;\n  margin-top: 18px;\n  flex-wrap: wrap;\n}\n\n.booking-facts div {\n  display: flex;\n  flex-direction: column;\n}\n\n.booking-facts strong {\n  font-size: 18px;\n  color: var(--brand-dark);\n}\n\n.booking-facts span {\n  font-size: 12px;\n  color: var(--ink-soft);\n}\n\n.booking-form {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.booking-form label {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  font-size: 13px;\n  color: var(--ink-soft);\n}\n\n.booking-form input,\n.booking-form select {\n  padding: 10px 12px;\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  background: #fff;\n  font-family: inherit;\n  font-size: 14px;\n  color: var(--ink);\n  outline: none;\n}\n\n.booking-form input:focus,\n.booking-form select:focus {\n  border-color: var(--brand);\n}\n\n.form-row {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n}\n\n.submit {\n  justify-content: center;\n  margin-top: 4px;\n}\n\n.error {\n  font-size: 13px;\n  color: #b3462f;\n}\n\n.success {\n  text-align: center;\n  padding: 18px 6px;\n}\n\n.success strong {\n  display: block;\n  font-size: 18px;\n  color: var(--accent);\n  margin-bottom: 10px;\n}\n\n.success p {\n  font-size: 14px;\n  color: var(--ink-soft);\n  margin-bottom: 18px;\n}\n\n.faq {\n  margin-bottom: 20px;\n}\n\n.faq-item {\n  padding: 16px 20px;\n  margin-bottom: 10px;\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: 12px;\n}\n\n.faq-item summary {\n  cursor: pointer;\n  font-weight: 600;\n  font-size: 15px;\n  list-style: none;\n}\n\n.faq-item summary::-webkit-details-marker {\n  display: none;\n}\n\n.faq-item summary::before {\n  content: '＋';\n  margin-right: 8px;\n  color: var(--brand);\n}\n\n.faq-item[open] summary::before {\n  content: '－';\n}\n\n.faq-item p {\n  margin-top: 10px;\n  font-size: 14px;\n  color: var(--ink-soft);\n}\n\n@media (max-width: 960px) {\n  .info-grid,\n  .two-col,\n  .booking {\n    grid-template-columns: 1fr;\n  }\n  .traffic-grid {\n    grid-template-columns: 1fr;\n  }\n  .page-head h1 {\n    font-size: 26px;\n  }\n}\n\n@media (max-width: 560px) {\n  .guide {\n    padding: 28px 0 12px;\n  }\n  .page-head h1 {\n    font-size: 21px;\n  }\n  .card {\n    padding: 18px 16px;\n  }\n  .block-head h2,\n  .booking-text h2 {\n    font-size: 20px;\n  }\n  .hours-list li {\n    grid-template-columns: 46px 1fr;\n  }\n  .hours-list .note {\n    display: none;\n  }\n  .booking {\n    padding: 22px 16px;\n  }\n  .form-row {\n    grid-template-columns: 1fr;\n  }\n  .booking-facts {\n    gap: 16px;\n  }\n}\n</style>\n",
  "src/pages/HomeView.vue": "<script setup>\nimport { ref, onMounted, onUnmounted } from 'vue'\nimport BookCard from '@/components/BookCard.vue'\nimport { books, events, notices } from '@/data/books.js'\n\nconst featured = books.filter((b) => b.status === '在馆').slice(0, 4)\nconst hero = 'https://picsum.photos/seed/reading-hall-hero/1200/900'\n\nconst stats = [\n  { value: '42,000+', label: '在架图书' },\n  { value: '260', label: '阅览座位' },\n  { value: '18', label: '年度共读活动' },\n  { value: '12h', label: '每日开放时长' }\n]\n\nconst services = [\n  {\n    icon: '📖',\n    title: '自由借阅',\n    desc: '凭身份证免费办理读者证，一次可借 6 册，借期 30 天，支持全城通借通还。'\n  },\n  {\n    icon: '🪑',\n    title: '安静自习',\n    desc: '三层静读区配备护眼灯与独立电源，需提前一天预约座位，每小时清理占座。'\n  },\n  {\n    icon: '🧸',\n    title: '亲子共读',\n    desc: '一层童书角铺有地毯与软垫，每周六上午有绘本故事会，家长可全程陪同。'\n  },\n  {\n    icon: '🎧',\n    title: '视听专区',\n    desc: '二层设有黑胶与有声书试听台，收录城市声音档案与本地音乐人作品。'\n  },\n  {\n    icon: '💬',\n    title: '城市讲堂',\n    desc: '每月邀请作者、编辑与研究者，围绕书与城市生活做两小时开放式分享。'\n  },\n  {\n    icon: '♻️',\n    title: '旧书漂流',\n    desc: '入口处的漂流书架欢迎带走一本、留下一本，让读过的书继续旅行。'\n  }\n]\n\nconst todayNotice = ref(0)\nlet timer = null\n\nonMounted(() => {\n  timer = setInterval(() => {\n    todayNotice.value = (todayNotice.value + 1) % notices.length\n  }, 4500)\n})\n\nonUnmounted(() => {\n  if (timer) clearInterval(timer)\n})\n</script>\n\n<template>\n  <div class=\"home\">\n    <section class=\"hero\">\n      <div class=\"wrap hero-inner\">\n        <div class=\"hero-text\">\n          <span class=\"eyebrow\">街角 · 城市阅读空间</span>\n          <h1>让城市慢下来，<br />让每一次翻页都有回声</h1>\n          <p>\n            拾光城市阅读馆坐落于文华路的老厂房里，四万余册藏书、三百多个座位，\n            从清晨的第一缕光到夜里的最后一盏灯，随时为你留一个位置。\n          </p>\n          <div class=\"hero-actions\">\n            <router-link to=\"/books\" class=\"btn btn-primary\">浏览馆藏书目</router-link>\n            <router-link to=\"/guide\" class=\"btn btn-ghost\">查看到馆指南</router-link>\n          </div>\n          <div class=\"notice-bar\">\n            <span class=\"dot\"></span>\n            <transition name=\"fade\" mode=\"out-in\">\n              <span :key=\"todayNotice\">{{ notices[todayNotice] }}</span>\n            </transition>\n          </div>\n        </div>\n        <div class=\"hero-media\">\n          <img :src=\"hero\" alt=\"阅读馆内景\" />\n          <div class=\"hero-card\">\n            <strong>今日已到馆</strong>\n            <span class=\"big\">386</span>\n            <small>阅览座位剩余 74 个</small>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"stats\">\n      <div class=\"wrap stat-grid\">\n        <div v-for=\"item in stats\" :key=\"item.label\" class=\"stat\">\n          <strong>{{ item.value }}</strong>\n          <span>{{ item.label }}</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">馆内服务</span>\n          <h2>不只是一间书房</h2>\n          <p>我们提供六类日常服务，覆盖借阅、自习、亲子、视听与城市文化活动，全部免费向公众开放。</p>\n        </div>\n        <div class=\"grid service-grid\">\n          <div v-for=\"s in services\" :key=\"s.title\" class=\"service\">\n            <span class=\"icon\">{{ s.icon }}</span>\n            <h3>{{ s.title }}</h3>\n            <p>{{ s.desc }}</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section alt\">\n      <div class=\"wrap\">\n        <div class=\"section-head row-head\">\n          <div>\n            <span class=\"eyebrow\">本周推荐</span>\n            <h2>书架上被翻得最旧的那几本</h2>\n            <p>由馆员与读者共同选出的在馆图书，扫码即可在借阅台预留。</p>\n          </div>\n          <router-link to=\"/books\" class=\"btn btn-ghost\">查看全部书目</router-link>\n        </div>\n        <div class=\"grid book-grid\">\n          <BookCard v-for=\"book in featured\" :key=\"book.id\" :book=\"book\" />\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\">\n      <div class=\"wrap event-wrap\">\n        <div>\n          <div class=\"section-head\">\n            <span class=\"eyebrow\">近期活动</span>\n            <h2>在馆里，遇见同频的人</h2>\n            <p>所有活动免费参与，部分场次需在服务台登记，名额先到先得。</p>\n          </div>\n          <div class=\"events\">\n            <div v-for=\"e in events\" :key=\"e.id\" class=\"event\">\n              <div class=\"date\">{{ e.date }}</div>\n              <div class=\"event-body\">\n                <h3>{{ e.title }}</h3>\n                <p>{{ e.desc }}</p>\n                <span class=\"event-meta\">{{ e.time }} · {{ e.place }}</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <aside class=\"side\">\n          <div class=\"side-card\">\n            <h3>开放时间</h3>\n            <ul>\n              <li><span>周一至周五</span><em>09:00 - 21:00</em></li>\n              <li><span>周六至周日</span><em>09:00 - 21:30</em></li>\n              <li><span>每月最后周一</span><em>13:00 起开馆</em></li>\n            </ul>\n            <router-link to=\"/guide\" class=\"btn btn-primary side-btn\">预约到馆</router-link>\n          </div>\n          <div class=\"side-card quote\">\n            <p>“一间好的图书馆，应该像城市的客厅——你随时可以进来，坐下，然后留下来。”</p>\n            <small>—— 首任馆长 · 林知远</small>\n          </div>\n        </aside>\n      </div>\n    </section>\n  </div>\n</template>\n\n<style scoped>\n.hero {\n  padding: 56px 0 40px;\n  background: radial-gradient(circle at 12% 10%, #f4e8d4 0%, var(--paper) 55%);\n}\n\n.hero-inner {\n  display: grid;\n  grid-template-columns: 1.05fr 1fr;\n  gap: 48px;\n  align-items: center;\n}\n\n.hero-text h1 {\n  font-size: 44px;\n  line-height: 1.28;\n}\n\n.hero-text p {\n  margin-top: 18px;\n  color: var(--ink-soft);\n  max-width: 480px;\n}\n\n.hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 26px;\n}\n\n.notice-bar {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  margin-top: 26px;\n  padding: 12px 16px;\n  border-left: 3px solid var(--brand);\n  background: #fff;\n  border-radius: 10px;\n  font-size: 14px;\n  color: var(--ink-soft);\n}\n\n.dot {\n  flex: none;\n  width: 7px;\n  height: 7px;\n  margin-top: 8px;\n  border-radius: 50%;\n  background: var(--brand);\n}\n\n.fade-enter-active,\n.fade-leave-active {\n  transition: opacity 0.3s ease;\n}\n\n.fade-enter-from,\n.fade-leave-to {\n  opacity: 0;\n}\n\n.hero-media {\n  position: relative;\n}\n\n.hero-media img {\n  width: 100%;\n  aspect-ratio: 4 / 3;\n  object-fit: cover;\n  border-radius: 22px;\n  box-shadow: var(--shadow);\n}\n\n.hero-card {\n  position: absolute;\n  left: -16px;\n  bottom: -22px;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  padding: 16px 22px;\n  background: #fff;\n  border-radius: 16px;\n  box-shadow: var(--shadow);\n}\n\n.hero-card strong {\n  font-size: 13px;\n  color: var(--ink-soft);\n  font-weight: 500;\n}\n\n.hero-card .big {\n  font-size: 30px;\n  font-weight: 700;\n  color: var(--brand);\n  line-height: 1.1;\n}\n\n.hero-card small {\n  font-size: 12px;\n  color: var(--ink-soft);\n}\n\n.stats {\n  padding-bottom: 8px;\n}\n\n.stat-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 16px;\n  padding: 26px 24px;\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: 20px;\n}\n\n.stat {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n  border-right: 1px solid var(--line);\n}\n\n.stat:last-child {\n  border-right: none;\n}\n\n.stat strong {\n  font-size: 26px;\n  color: var(--brand-dark);\n}\n\n.stat span {\n  font-size: 13px;\n  color: var(--ink-soft);\n}\n\n.service-grid {\n  grid-template-columns: repeat(3, 1fr);\n}\n\n.service {\n  padding: 24px;\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n\n.service:hover {\n  transform: translateY(-4px);\n  box-shadow: var(--shadow);\n}\n\n.service .icon {\n  display: grid;\n  place-items: center;\n  width: 44px;\n  height: 44px;\n  margin-bottom: 14px;\n  border-radius: 12px;\n  background: var(--brand-soft);\n  font-size: 21px;\n}\n\n.service h3 {\n  font-size: 17px;\n  margin-bottom: 8px;\n}\n\n.service p {\n  font-size: 14px;\n  color: var(--ink-soft);\n}\n\n.alt {\n  background: #f2eee4;\n}\n\n.row-head {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 20px;\n  max-width: none;\n}\n\n.book-grid {\n  grid-template-columns: repeat(4, 1fr);\n}\n\n.event-wrap {\n  display: grid;\n  grid-template-columns: 1.6fr 1fr;\n  gap: 40px;\n  align-items: start;\n}\n\n.events {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n\n.event {\n  display: flex;\n  gap: 18px;\n  padding: 18px 20px;\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: 14px;\n}\n\n.date {\n  flex: none;\n  width: 74px;\n  font-size: 14px;\n  font-weight: 700;\n  color: var(--brand-dark);\n}\n\n.event-body h3 {\n  font-size: 16px;\n}\n\n.event-body p {\n  margin: 6px 0 8px;\n  font-size: 14px;\n  color: var(--ink-soft);\n}\n\n.event-meta {\n  font-size: 12px;\n  color: var(--brand);\n}\n\n.side {\n  display: flex;\n  flex-direction: column;\n  gap: 18px;\n}\n\n.side-card {\n  padding: 24px;\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n}\n\n.side-card h3 {\n  font-size: 17px;\n  margin-bottom: 12px;\n}\n\n.side-card ul {\n  list-style: none;\n  margin: 0 0 16px;\n  padding: 0;\n}\n\n.side-card li {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 8px 0;\n  border-bottom: 1px dashed var(--line);\n  font-size: 14px;\n  color: var(--ink-soft);\n}\n\n.side-card li em {\n  font-style: normal;\n  color: var(--ink);\n  font-weight: 600;\n}\n\n.side-btn {\n  width: 100%;\n  justify-content: center;\n}\n\n.quote {\n  background: #23282c;\n  border-color: #23282c;\n  color: #e6e1d7;\n}\n\n.quote p {\n  font-size: 15px;\n  line-height: 1.85;\n}\n\n.quote small {\n  display: block;\n  margin-top: 12px;\n  font-size: 12px;\n  color: #a7a197;\n}\n\n@media (max-width: 1000px) {\n  .hero-inner {\n    grid-template-columns: 1fr;\n    gap: 34px;\n  }\n  .hero-text h1 {\n    font-size: 36px;\n  }\n  .hero-media img {\n    aspect-ratio: 16 / 9;\n  }\n  .hero-card {\n    left: auto;\n    right: 16px;\n    bottom: -18px;\n    padding: 12px 18px;\n  }\n  .service-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .book-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .event-wrap {\n    grid-template-columns: 1fr;\n    gap: 28px;\n  }\n}\n\n@media (max-width: 640px) {\n  .hero {\n    padding: 34px 0 26px;\n  }\n  .hero-text h1 {\n    font-size: 27px;\n  }\n  .hero-text p {\n    font-size: 14px;\n  }\n  .hero-actions .btn {\n    flex: 1;\n    justify-content: center;\n  }\n  .stat-grid {\n    grid-template-columns: repeat(2, 1fr);\n    gap: 20px 8px;\n    padding: 20px 16px;\n  }\n  .stat {\n    border-right: none;\n  }\n  .stat strong {\n    font-size: 22px;\n  }\n  .service-grid {\n    grid-template-columns: 1fr;\n  }\n  .book-grid {\n    grid-template-columns: 1fr;\n  }\n  .row-head {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n  .event {\n    flex-direction: column;\n    gap: 6px;\n  }\n  .date {\n    width: auto;\n  }\n}\n</style>\n",
  "src/router/index.js": "import { createRouter, createWebHashHistory } from 'vue-router'\nimport HomeView from '@/pages/HomeView.vue'\nimport BooksView from '@/pages/BooksView.vue'\nimport GuideView from '@/pages/GuideView.vue'\n\nconst router = createRouter({\n  history: createWebHashHistory(),\n  routes: [\n    { path: '/', name: 'home', component: HomeView, meta: { title: '首页' } },\n    { path: '/books', name: 'books', component: BooksView, meta: { title: '馆藏书目' } },\n    { path: '/guide', name: 'guide', component: GuideView, meta: { title: '到馆指南' } },\n    { path: '/:pathMatch(.*)*', redirect: '/' }\n  ],\n  scrollBehavior() {\n    return { top: 0 }\n  }\n})\n\nexport default router\n",
  "src/styles/global.css": ":root {\n  --ink: #1f2529;\n  --ink-soft: #5c6873;\n  --line: #e7e1d6;\n  --paper: #f8f5ee;\n  --card: #ffffff;\n  --brand: #8a5a2b;\n  --brand-dark: #6d451f;\n  --brand-soft: #f2e6d5;\n  --accent: #2f6b5f;\n  --radius: 16px;\n  --shadow: 0 12px 30px rgba(31, 37, 41, 0.08);\n  --max: 1180px;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml,\nbody {\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  background: var(--paper);\n  color: var(--ink);\n  font-family: \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Noto Sans SC\", system-ui, -apple-system, sans-serif;\n  font-size: 16px;\n  line-height: 1.7;\n  -webkit-font-smoothing: antialiased;\n}\n\nimg {\n  display: block;\n  max-width: 100%;\n}\n\na {\n  color: inherit;\n  text-decoration: none;\n}\n\nh1,\nh2,\nh3,\nh4 {\n  margin: 0;\n  line-height: 1.35;\n  font-weight: 700;\n  letter-spacing: 0.01em;\n}\n\np {\n  margin: 0;\n}\n\nbutton {\n  font-family: inherit;\n  cursor: pointer;\n}\n\n.wrap {\n  width: 100%;\n  max-width: var(--max);\n  margin: 0 auto;\n  padding: 0 24px;\n}\n\n.section {\n  padding: 64px 0;\n}\n\n.section-head {\n  max-width: 640px;\n  margin-bottom: 32px;\n}\n\n.section-head h2 {\n  font-size: 28px;\n}\n\n.section-head p {\n  margin-top: 10px;\n  color: var(--ink-soft);\n}\n\n.eyebrow {\n  display: inline-block;\n  padding: 4px 12px;\n  margin-bottom: 14px;\n  border-radius: 999px;\n  background: var(--brand-soft);\n  color: var(--brand-dark);\n  font-size: 13px;\n  letter-spacing: 0.08em;\n}\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 12px 24px;\n  border: 1px solid transparent;\n  border-radius: 999px;\n  font-size: 15px;\n  font-weight: 600;\n  transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease;\n}\n\n.btn:hover {\n  transform: translateY(-2px);\n}\n\n.btn-primary {\n  background: var(--brand);\n  color: #fff;\n}\n\n.btn-primary:hover {\n  background: var(--brand-dark);\n}\n\n.btn-ghost {\n  background: #fff;\n  border-color: var(--line);\n  color: var(--ink);\n}\n\n.grid {\n  display: grid;\n  gap: 22px;\n}\n\n@media (max-width: 900px) {\n  .section {\n    padding: 48px 0;\n  }\n  .section-head h2 {\n    font-size: 24px;\n  }\n}\n\n@media (max-width: 560px) {\n  .wrap {\n    padding: 0 16px;\n  }\n  .section {\n    padding: 38px 0;\n  }\n  .section-head h2 {\n    font-size: 21px;\n  }\n  body {\n    font-size: 15px;\n  }\n}\n",
  "vite.config.js": "import { defineConfig } from 'vite'\nimport vue from '@vitejs/plugin-vue'\nimport { fileURLToPath, URL } from 'node:url'\nexport default defineConfig({\n  base: './', plugins: [vue()],\n  resolve: { alias: { '@': fileURLToPath(new URL('./src', import.meta.url)) } },\n  build: { assetsInlineLimit: 2000000, cssCodeSplit: false,\n    rollupOptions: { output: { inlineDynamicImports: true } } }\n})\n"
